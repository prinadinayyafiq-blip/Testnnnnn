    TText.Font = Enum.Font.GothamBold
    TText.Text = message
    TText.TextColor3 = Color3.fromRGB(255, 255, 255)
    TText.TextSize = 12

    Toast:TweenPosition(UDim2.new(0.5, -130, 0, 15), Enum.EasingDirection.Out, Enum.EasingStyle.Back, 0.3, true)

    task.delay(2.2, function()
        if Toast and Toast.Parent then
            Toast:TweenPosition(UDim2.new(0.5, -130, 0, -50), Enum.EasingDirection.In, Enum.EasingStyle.Quad, 0.3, true)
