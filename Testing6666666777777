-- FE Single Animation Changer
local function applySingleAnimation(key, rawId, showMsg)
    local char = LocalPlayer.Character
    if not char then return end
    local animateScript = char:FindFirstChild("Animate")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not animateScript or not humanoid then return end

    local cleanId = tostring(rawId):match("%d+")
    if not cleanId then return end
    local formattedId = "rbxassetid://" .. cleanId

    local folder = animateScript:FindFirstChild(key)
    if folder then
        for _, anim in ipairs(folder:GetChildren()) do
            if anim:IsA("Animation") then
                anim.AnimationId = formattedId
            end
        end
    end

    local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        track:Stop(0)
    end
    humanoid:ChangeState(Enum.HumanoidStateType.Landed)

    if showMsg then
        showToast("⚡ Gerakan " .. key:upper() .. " diganti!", true)
    end
end

-- FE Full Animation Apply
local function applyAnimations(ids, showMsg)
    local char = LocalPlayer.Character
    if not char then return false end
    for key, val in pairs(ids) do
        applySingleAnimation(key, val, false)
    end
    if showMsg then showToast("✨ Semua animasi diterapkan!", true) end
    return true
end

-- 3D Viewport Setup
local previewModel
local previewWorld = Instance.new("WorldModel")
previewWorld.Parent = ViewportFrame

local previewCam = Instance.new("Camera")
previewCam.Parent = ViewportFrame
ViewportFrame.CurrentCamera = previewCam

local function setupViewportPreview(animId)
    if previewModel then previewModel:Destroy() end
    local char = LocalPlayer.Character
    if not char then return end

    char.Archivable = true
    previewModel = char:Clone()
    char.Archivable = false
    previewModel.Parent = previewWorld

    local hrp = previewModel:FindFirstChild("HumanoidRootPart")
    if hrp then
        previewCam.CFrame = CFrame.new(hrp.Position + hrp.CFrame.LookVector * 5.5 + Vector3.new(0, 0.5, 0), hrp.Position)
    end

    local hum = previewModel:FindFirstChildOfClass("Humanoid")
    if hum and animId then
        local animObj = Instance.new("Animation")
        animObj.AnimationId = "rbxassetid://" .. animId
        local track = hum:LoadAnimation(animObj)
        track:Play()
    end
end

