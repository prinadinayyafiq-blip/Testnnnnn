local function showToast(message, isSuccess)
    local Toast = Instance.new("Frame")
    Toast.Parent = ScreenGui
    Toast.BackgroundColor3 = isSuccess and Color3.fromRGB(0, 175, 100) or Color3.fromRGB(220, 60, 60)
    Toast.Position = UDim2.new(0.5, -130, 0, -40)
